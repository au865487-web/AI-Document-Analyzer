# Groq API credentials - https://console.groq.com/keys
# Leave empty to index documents without asking questions.
# The Streamlit UI never displays this value.
GROQ_API_KEY=

# Groq chat model, e.g. "llama-3.3-70b-versatile" or "mixtral-8x7b-32768".
# Leave empty to use the application default.
GROQ_MODEL=

# sentence-transformer model used to embed documents and queries.
# Leave empty for the default: "all-MiniLM-L6-v2".
EMBEDDING_MODEL=